# Copia este archivo como .env y cambia los valores.
#
#   cp .env.example .env
#
# El servidor NO arranca si faltan estos dos.

# Contraseña para entrar al panel /admin.
ADMIN_PASSWORD=cambia_esta_contraseña

# Cualquier texto largo y difícil de adivinar. Es la sesión del admin.
ADMIN_TOKEN=cambia_este_token_por_algo_largo_y_aleatorio


# --- Ajustes opcionales del juego ---
# Si los borras se usan estos mismos valores por defecto.

# Duración de cada ronda, en segundos.
SEGUNDOS_PARTIDA=120

# Intentos y pistas por jugador en cada ronda.
MAX_INTENTOS=5
MAX_PISTAS=3

# Cuántos jugadores caben en una sala con código.
MAX_JUGADORES=30
